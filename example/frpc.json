{
    "frp": {
        "server": "proxy.example.com:7000",
        "token": "${FRP_TOKEN}"
    },
    "routes": [
        {
            "type": "TCP",
            "target": "server:5000",
            "port": 5000
        },
        {
            "type": "UDP",
            "target": "server:5001",
            "port": 5001
        },
        {
            "type": "HTTP",
            "target": "frontend:3000",
            "domains": [
                "test.example.com"
            ]
        }
    ]
}
